<script type="text/plain" data-res="lists/webshell-names.txt"># Web shell basenames (regex over lower-cased basename)
re:^(?:cmd|cmdasp|shell|c99|r57|wso|b374k|caidao|chopper|aspxspy|aspxshell|spy|ma|x|a|z|1|2|t|test1|tmp|up|upload1|login2|asp\.?net|xx|devil|hack|bypass|r00t|sh3ll|webshell|antsword|godzilla|behinder|reGeorg|tunnel|proxy|socks)\.(?:aspx|ashx|asmx|asp|php|jsp|jspx|cer|asa)$
re:^(?:help|error|default|index)[0-9]+\.(?:aspx|ashx|asp|php|jsp)$
re:^[0-9a-f]{8,}\.(?:aspx|ashx|asp|php|jsp)$
</script>
<script type="text/plain" data-res="lists/webshell-parameters.txt"># Query parameters typical of web shell interaction (regex over lower-cased decoded query)
re:(?:^|&)(?:cmd|exec|command|execute|shell|func|z0|z1|z2|pass|pwd|ant|payload)=
re:(?:^|&)action=(?:cmd|exec|shell|upload|download)
</script>

<script>
  /* Early error hook: script load/parse failures are written to %TEMP%\iisla-startup-error.log and shown on screen. */
  window.__iislaEarlyError = function (msg, url, line) {
    try {
      var sh = new ActiveXObject('WScript.Shell'), p = sh.ExpandEnvironmentStrings('%TEMP%') + String.fromCharCode(92) + 'iisla-startup-error.log';
      var ts = new ActiveXObject('Scripting.FileSystemObject').OpenTextFile(p, 8, true, 0);
      ts.WriteLine(String(new Date()) + ' documentMode=' + document.documentMode + ' ' + msg + ' @ ' + url + ':' + line); ts.Close();
    } catch (e) { }
    var d = document.getElementById('app');
    if (d) { d.textContent = 'Startup error: ' + msg + ' @ ' + url + ':' + line; d.style.color = '#c53030'; d.style.padding = '20px'; }
    return true;
  };
  window.onerror = window.__iislaEarlyError;
</script>
