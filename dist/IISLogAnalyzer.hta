    var full = A.indexPath(site, site.files), i;
    for (i = 0; i < candidates.length; i++) { if (candidates[i].path.toLowerCase() === full.toLowerCase()) { best = candidates[i]; } }
    if (!best && candidates.length) { best = candidates[0]; }
    if (!best) { return false; }
