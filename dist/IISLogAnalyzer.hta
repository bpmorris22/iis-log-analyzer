<script>/* lib/parser.js */
/* IIS Log Analyzer - parser.js
 * W3C Extended Log File Format parsing with per-block field re-binding,
 * plus cached derivation of stem / query / user-agent / IP attributes.
 */
(function (NS) {
  'use strict';
