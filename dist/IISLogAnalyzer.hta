      if (e.keyCode === 13 && opts.enterButton !== undefined && (e.target || e.srcElement).tagName !== 'TEXTAREA') {
        var b = bs[opts.enterButton]; var keep = b.onClick ? b.onClick(dlg) : undefined; if (keep !== false) { dlg.close(); } return false;
      }
