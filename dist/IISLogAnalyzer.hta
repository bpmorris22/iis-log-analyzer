<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta charset="utf-8">
<title>IIS Log Analyzer</title>
<HTA:APPLICATION
    ID="IISLA" APPLICATIONNAME="IIS Log Analyzer"
    BORDER="thick" BORDERSTYLE="normal" CAPTION="yes"
    MAXIMIZEBUTTON="yes" MINIMIZEBUTTON="yes" SYSMENU="yes"
    SHOWINTASKBAR="yes" SINGLEINSTANCE="no" SCROLL="no"
    SELECTION="yes" CONTEXTMENU="yes" NAVIGABLE="no"
    WINDOWSTATE="maximize" />
<!-- IIS Log Analyzer: offline analysis of IIS W3C Extended logs for DFIR.
     Runs in mshta.exe (IE11 document mode). No network resources are referenced. -->
<style id="appcss">
/* IIS Log Analyzer - app.css (IE11 document mode) */
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; background: #f4f6f9; color: #1a202c; font: 12px/1.4 "Segoe UI", Tahoma, Arial, sans-serif; }
#app { display: -ms-flexbox; display: flex; -ms-flex-direction: column; flex-direction: column; height: 100%; }
#toolbar { -ms-flex: 0 0 auto; flex: 0 0 auto; background: #1f2d3d; color: #fff; padding: 5px 8px; display: -ms-flexbox; display: flex; -ms-flex-align: center; align-items: center; }
#toolbar .brand { font-weight: 600; font-size: 14px; margin-right: 14px; letter-spacing: .2px; }
#toolbar .brand-ver { font-weight: normal; font-size: 11px; margin-left: 2px; padding: 1px 5px; border-radius: 3px; background: rgba(255, 255, 255, .14); cursor: pointer; }
#toolbar .brand-ver:hover { background: rgba(255, 255, 255, .28); }
#toolbar .brand-ver.old { background: #ecc94b; color: #1a202c; font-weight: 600; }
#toolbar .brand-ver.old:hover { background: #f6e05e; }
.upd-notes { white-space: pre-wrap; max-height: 260px; overflow: auto; background: #f7fafc; border: 1px solid #e2e8f0; border-radius: 4px; padding: 6px 8px; margin: 8px 0; font-size: 12px; }
#toolbar .btn { background: #2f4a66; color: #fff; border-color: #3d5d80; margin-right: 4px; }
#toolbar .btn:hover { background: #3b5a7c; }
.tb-right { margin-left: auto; }
.tb-info { margin-left: 12px; color: #cbd5e0; }
.tb-info.warn { color: #fbd38d; }
#mid { -ms-flex: 1 1 auto; flex: 1 1 auto; display: -ms-flexbox; display: flex; min-height: 0; }
#nav { -ms-flex: 0 0 150px; flex: 0 0 150px; background: #e7ebf0; border-right: 1px solid #cfd6df; overflow-y: auto; padding-top: 4px; }
.nav-i { padding: 6px 10px; cursor: pointer; border-left: 3px solid transparent; }
.nav-i:hover { background: #dce3eb; }
.nav-i.active { background: #fff; border-left-color: #2b6cb0; font-weight: 600; }
.badge { float: right; background: #a0aec0; color: #fff; border-radius: 8px; padding: 0 6px; font-size: 10px; font-weight: normal; }
.badge.hot { background: #c53030; }
/* Log Parser traffic light */
.tl { display: inline-block; vertical-align: middle; background: #2d3748; border-radius: 9px; padding: 3px 4px; }
.tl-l { display: block; width: 14px; height: 14px; margin: 3px 0; border-radius: 50%; background: #4a5568; }
.tl-l.red.on { background: #e53e3e; box-shadow: 0 0 6px #e53e3e; }
.tl-l.amber.on { background: #ecc94b; box-shadow: 0 0 6px #ecc94b; }
.tl-l.green.on { background: #38a169; box-shadow: 0 0 6px #38a169; }
.tl-dot { float: right; width: 10px; height: 10px; margin-top: 4px; border-radius: 50%; border: 1px solid rgba(0, 0, 0, .25); }
.tl-dot.red { background: #e53e3e; } .tl-dot.amber { background: #ecc94b; } .tl-dot.green { background: #38a169; }
.lp-status { display: -ms-flexbox; display: flex; -ms-flex-align: center; align-items: center; background: #fff; border: 1px solid #d5dce5; border-radius: 6px; padding: 8px 12px; margin: 4px 0 12px; }
.lp-status > * { margin-right: 12px; }
.lp-status-t { -ms-flex: 1 1 auto; flex: 1 1 auto; min-width: 0; }
#main { -ms-flex: 1 1 auto; flex: 1 1 auto; overflow: auto; min-width: 0; position: relative; display: -ms-flexbox; display: flex; -ms-flex-direction: column; flex-direction: column; }
#statusbar { -ms-flex: 0 0 auto; flex: 0 0 auto; background: #e2e8f0; border-top: 1px solid #cbd5e0; padding: 3px 8px; color: #2d3748; white-space: nowrap; overflow: hidden; }
#statusbar .busy { color: #c05621; font-weight: 600; }
.page-h { padding: 8px 12px 4px; display: -ms-flexbox; display: flex; -ms-flex-align: baseline; align-items: baseline; -ms-flex-wrap: wrap; flex-wrap: wrap; }
.page-h h1 { font-size: 17px; margin: 0 12px 0 0; font-weight: 600; }
.page-sub { color: #4a5568; }
.page-tools { margin-left: auto; }
.page-tools .btn { margin-left: 4px; }
.page-b { padding: 4px 12px 16px; }
.page-b.page-fill { -ms-flex: 1 1 auto; flex: 1 1 auto; display: -ms-flexbox; display: flex; -ms-flex-direction: column; flex-direction: column; min-height: 0; padding-bottom: 4px; }
.pad { padding: 12px; }
.btn { font: inherit; padding: 3px 10px; border: 1px solid #a0aec0; background: #fff; border-radius: 3px; cursor: pointer; color: #1a202c; }
.btn:hover { background: #edf2f7; }
.btn.primary { background: #2b6cb0; border-color: #2c5282; color: #fff; }
.btn.primary:hover { background: #2c5282; }
input[type=text], select, textarea { font: inherit; border: 1px solid #a0aec0; padding: 2px 4px; border-radius: 2px; background: #fff; }
textarea { font-family: Consolas, monospace; }
.row { display: -ms-flexbox; display: flex; -ms-flex-wrap: wrap; flex-wrap: wrap; -ms-flex-align: end; align-items: flex-end; margin: 4px 0; }
.row > * { margin-right: 8px; margin-bottom: 2px; }
.row .sp { -ms-flex: 1 1 auto; flex: 1 1 auto; }
.field { display: inline-block; vertical-align: bottom; }
.field-l { display: block; font-size: 11px; color: #4a5568; margin-bottom: 1px; }
.hint { display: block; font-size: 10px; color: #718096; }
.chk { white-space: nowrap; }
.mt { margin-top: 8px; }
.mb { margin-bottom: 6px; }
.muted { color: #718096; }
.small { font-size: 11px; }
.mono { font-family: Consolas, monospace; }
.big { font-size: 14px; margin: 4px 0 8px; word-break: break-all; }
.warn { color: #9c4221; }
.error { color: #c53030; }
.pre-wrap { white-space: pre-wrap; word-wrap: break-word; }
.fatal { padding: 30px; font-size: 16px; color: #c53030; }
.banner { padding: 6px 10px; margin: 4px 0 8px; border-radius: 3px; }
.banner.warn { background: #fffaf0; border: 1px solid #f6ad55; }
a.lnk { color: #2b6cb0; text-decoration: none; cursor: pointer; }
a.lnk:hover { text-decoration: underline; }
.section { background: #fff; border: 1px solid #d5dce5; border-radius: 4px; margin: 8px 0; }
.section-h { padding: 5px 10px; background: #f7f9fb; border-bottom: 1px solid #e2e8f0; font-weight: 600; display: -ms-flexbox; display: flex; }
.section-tools { margin-left: auto; font-weight: normal; }
.section-b { padding: 6px 10px; overflow-x: auto; }
.cols2 { display: -ms-flexbox; display: flex; }
.cols2 > * { -ms-flex: 1 1 50%; flex: 1 1 50%; min-width: 0; margin-right: 8px; }
.cols2 > *:last-child { margin-right: 0; }
.cards { display: -ms-flexbox; display: flex; -ms-flex-wrap: wrap; flex-wrap: wrap; margin: 4px 0; }
.card { background: #fff; border: 1px solid #d5dce5; border-left: 4px solid #2b6cb0; border-radius: 3px; padding: 6px 10px; margin: 0 8px 8px 0; min-width: 150px; }
.card.clickable { cursor: pointer; }
.card.clickable:hover { background: #f7fafc; }
.card.hot { border-left-color: #c53030; }
.card.warm { border-left-color: #dd6b20; }
.card-t { font-size: 11px; color: #4a5568; }
.card-v { font-size: 18px; font-weight: 600; white-space: nowrap; }
.card-s { font-size: 11px; color: #718096; }
table.kv { border-collapse: collapse; width: 100%; }
table.kv th { text-align: left; vertical-align: top; color: #4a5568; font-weight: 600; padding: 2px 10px 2px 0; width: 170px; white-space: nowrap; }
table.kv td { padding: 2px 0; word-break: break-all; white-space: pre-wrap; }
table.kv td.warn { color: #c05621; font-weight: 600; }
table.kv td.mono { font-family: Consolas, monospace; }
table.tbl { border-collapse: collapse; width: 100%; font-size: 12px; }
table.tbl th { text-align: left; background: #edf2f7; border-bottom: 1px solid #cbd5e0; padding: 3px 6px; white-space: nowrap; }
table.tbl td { border-bottom: 1px solid #edf2f7; padding: 2px 6px; vertical-align: top; word-break: break-all; }
table.tbl tr.clickable { cursor: pointer; }
table.tbl th.sortable { cursor: pointer; user-select: none; }
table.tbl th.sortable:hover { background: #e2e8f0; }
table.tbl th .sort-arrow { color: #4a5568; }
table.tbl tr:hover td { background: #f7fafc; }
.sev { white-space: nowrap; display: inline-block; padding: 0 5px; border-radius: 3px; color: #fff; font-size: 10px; text-transform: uppercase; line-height: 15px; }
.sev-critical { background: #742a2a; } .sev-high { background: #c53030; } .sev-medium { background: #dd6b20; } .sev-low { background: #b7791f; } .sev-info { background: #718096; }
.chip { display: inline-block; padding: 0 7px; margin: 1px 3px 1px 0; border: 1px solid #a0aec0; border-radius: 9px; cursor: pointer; font-size: 11px; line-height: 16px; background: #fff; }
.chip.on { color: #fff; }
.notes { margin: 6px 0; }
.note { background: #fffbea; border-left: 3px solid #d69e2e; padding: 3px 8px; margin: 3px 0; white-space: pre-wrap; }
.recent { margin-top: 4px; font-size: 11px; }
/* virtual grid */
.vg { position: relative; display: -ms-flexbox; display: flex; -ms-flex-direction: column; flex-direction: column; height: 100%; min-height: 80px; border: 1px solid #cbd5e0; background: #fff; outline: none; }
.vg:focus { border-color: #63b3ed; }
.vg-head { -ms-flex: 0 0 22px; flex: 0 0 22px; height: 22px; overflow: hidden; background: #edf2f7; border-bottom: 1px solid #cbd5e0; position: relative; }
.vg-head-in { position: relative; height: 22px; }
.vg-hc { position: absolute; top: 0; height: 22px; line-height: 22px; padding: 0 4px; font-weight: 600; white-space: nowrap; overflow: hidden; cursor: pointer; border-right: 1px solid #d5dce5; }
.vg-hc.num { text-align: right; }
.vg-hc:hover { background: #e2e8f0; }
.vg-grip { position: absolute; right: -3px; top: 0; width: 7px; height: 22px; cursor: col-resize; z-index: 2; }
.vg-body { -ms-flex: 1 1 auto; flex: 1 1 auto; position: relative; overflow: auto; min-height: 0; }
.vg-spacer { position: absolute; left: 0; top: 0; width: 1px; }
.vg-layer { position: absolute; left: 0; top: 0; }
.vg-row { position: absolute; left: 0; white-space: nowrap; cursor: default; }
.vg-row.odd { background: #f8fafc; }
.vg-row.s4 { color: #9c4221; }
.vg-row.s5 { color: #c53030; font-weight: 600; }
.vg-row.hit2 { background: #faf5ff; }
.vg-row.hit3 { background: #fefcbf; }
.vg-row.hit4, .vg-row.hit5 { background: #fff5f5; }
.vg-row.tagged { box-shadow: inset 3px 0 0 #805ad5; }
.vg-row.fp { color: #a0aec0; text-decoration: line-through; }
.vg-row.sevrow-critical .vg-c:nth-child(2), .vg-row.sevrow-high .vg-c:nth-child(2) { color: #c53030; font-weight: 600; }
.vg-row.sevrow-medium .vg-c:nth-child(2) { color: #c05621; }
.vg-row.sel { background: #bee3f8 !important; color: #1a202c; }
.vg-c { position: absolute; top: 0; height: 100%; line-height: 19px; padding: 0 4px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; border-right: 1px solid #f0f3f7; }
.vg-c.num { text-align: right; }
.vg-c.pin { z-index: 1; background: #f3f6fa; border-right: 1px solid #cbd5e0; }
.vg-row.sel .vg-c.pin { background: #bee3f8; }
.vg-hc.pin { z-index: 2; background: #e2e8f0; }
.vg-empty { position: absolute; top: 40px; width: 100%; text-align: center; color: #a0aec0; }
.grid-host { height: 260px; }
.grid-host.tall { height: 560px; }
.grid-area { -ms-flex: 1 1 auto; flex: 1 1 auto; display: -ms-flexbox; display: flex; -ms-flex-direction: column; flex-direction: column; min-height: 0; }
.grid-area .grid-host { -ms-flex: 1 1 auto; flex: 1 1 auto; height: auto; min-height: 120px; }
.hsplit { -ms-flex: 0 0 5px; flex: 0 0 5px; height: 5px; cursor: row-resize; background: #e2e8f0; }
.detail { background: #fff; border: 1px solid #d5dce5; padding: 6px 10px; overflow: auto; }
.grid-detail { -ms-flex: 0 0 auto; flex: 0 0 auto; height: 230px; }
.det-cols { display: -ms-flexbox; display: flex; }
.det-main { -ms-flex: 1 1 auto; flex: 1 1 auto; min-width: 0; width: 100%; }
.det-main table.kv th { width: 110px; }
.det-side { -ms-flex: 0 0 360px; flex: 0 0 360px; padding-left: 12px; border-left: 1px solid #edf2f7; }
.det-h { margin-bottom: 4px; }
.rawline { font-family: Consolas, monospace; font-size: 11px; background: #f7fafc; border: 1px solid #e2e8f0; padding: 3px 6px; margin-top: 6px; word-break: break-all; white-space: pre-wrap; }
.split-v { display: -ms-flexbox; display: flex; -ms-flex-direction: column; flex-direction: column; }
.split-top { height: 330px; }
.split-bottom { margin-top: 6px; min-height: 200px; }
.split-bottom .grid-host { height: 300px; }
.qfrow .qf { -ms-flex: 1 1 auto; flex: 1 1 auto; min-width: 300px; font-family: Consolas, monospace; padding: 4px; }
.crumbs { margin: 2px 0 4px; }
.crumb { display: inline-block; background: #ebf8ff; border: 1px solid #90cdf4; border-radius: 3px; padding: 0 4px 0 6px; margin: 0 4px 2px 0; font-family: Consolas, monospace; font-size: 11px; }
.crumb.neg { background: #fff5f5; border-color: #feb2b2; }
.crumb .x { cursor: pointer; margin-left: 5px; color: #718096; font-weight: 600; }
/* charts */
.chart-host { width: 100%; overflow: hidden; min-height: 40px; }
svg.chart text.axis { font-size: 10px; fill: #4a5568; }
svg.chart line.grid { stroke: #edf2f7; }
svg.chart rect.hit { cursor: crosshair; }
svg.chart rect.hit:hover { fill: rgba(43, 108, 176, .10); }
svg.chart rect.brush { fill: rgba(43, 108, 176, .25); stroke: #2b6cb0; }
/* raw context */
.rawctx { font-family: Consolas, monospace; font-size: 11px; background: #fff; border: 1px solid #e2e8f0; overflow: auto; }
.dialog .rawctx { height: 440px; }
.rl { white-space: pre; padding: 0 4px; }
.rl.hl { background: #fefcbf; font-weight: 600; }
.rl.dir { color: #718096; }
.rl.clickable { cursor: pointer; }
.ln { display: inline-block; min-width: 52px; color: #a0aec0; margin-right: 8px; text-align: right; }
/* dialogs */
.overlay { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(26, 32, 44, .45); z-index: 100; }
.dialog { position: absolute; left: 50%; top: 8%; -ms-transform: translateX(-50%); transform: translateX(-50%); background: #fff; border-radius: 5px; box-shadow: 0 8px 30px rgba(0, 0, 0, .35); max-width: 96%; }
.dialog-h { padding: 8px 12px; background: #1f2d3d; color: #fff; border-radius: 5px 5px 0 0; font-weight: 600; display: -ms-flexbox; display: flex; }
.dialog-h .x { margin-left: auto; cursor: pointer; font-size: 16px; line-height: 14px; }
.dialog-b { padding: 10px 12px; max-height: 70vh; overflow: auto; }
.dialog-f { padding: 8px 12px; border-top: 1px solid #e2e8f0; text-align: right; }
.dialog-f .btn { margin-left: 6px; }
.pbar { height: 14px; background: #edf2f7; border: 1px solid #cbd5e0; border-radius: 3px; overflow: hidden; }
.pbar-fill { height: 100%; width: 0; background: #2b6cb0; }
.pinfo { margin-top: 6px; }
.pcur { color: #718096; font-size: 11px; word-break: break-all; }
.exportlist .export-i { padding: 6px 8px; border: 1px solid #e2e8f0; border-radius: 3px; margin-bottom: 4px; cursor: pointer; }
.exportlist .export-i:hover { background: #ebf8ff; border-color: #90cdf4; }
.collist .colrow { padding: 2px 0; }
.rulelist { max-height: 320px; overflow: auto; }
.rulerow { padding: 2px 0; white-space: nowrap; }
.iocbox { width: 100%; }
/* menu / toasts */
.menu { position: fixed; z-index: 200; background: #fff; border: 1px solid #a0aec0; box-shadow: 0 4px 16px rgba(0, 0, 0, .25); padding: 3px 0; min-width: 200px; }
.menu-i { padding: 4px 14px; cursor: pointer; white-space: nowrap; }
.menu-i:hover { background: #2b6cb0; color: #fff; }
.menu-i.disabled { color: #a0aec0; cursor: default; }
.menu-i.disabled:hover { background: none; color: #a0aec0; }
.menu-h { padding: 3px 10px 1px; font-size: 10px; color: #718096; text-transform: uppercase; }
.menu-sep { border-top: 1px solid #e2e8f0; margin: 3px 0; }
#toasts { position: fixed; right: 12px; bottom: 30px; z-index: 300; width: 380px; }
.toast { background: #2d3748; color: #fff; padding: 7px 10px; border-radius: 4px; margin-top: 6px; box-shadow: 0 3px 10px rgba(0, 0, 0, .3); word-wrap: break-word; }
.toast.error { background: #c53030; }
.toast.warn { background: #c05621; }
/* text size controls */
.zoom { margin-left: 14px; white-space: nowrap; }
#toolbar .zbtn { padding: 1px 7px; margin: 0 0 0 2px; font-weight: 600; }
#toolbar .zval { min-width: 48px; font-weight: normal; }

</style>
</head>
<body>
<div id="app"><div style="padding:30px;font:14px Segoe UI">Loading IIS Log Analyzer&hellip;</div></div>
<div id="toasts"></div>
<script type="text/plain" data-res="rules/default-rules.json">{
  "version": "1.1.0",
  "notes": "Built-in rules have logic in lib/rules.js keyed by id; their thresholds come from 'params' here. Any rule with a 'match' block and an id not handled by lib/rules.js is compiled as a custom row rule (see README).",
  "rules": [
    { "id": "R-SCAN-001", "name": "High 404 volume from single public client", "category": "Reconnaissance", "severity": "medium", "scope": "aggregate", "entity": "ip",
      "attack": ["T1595.003"], "enabled": true, "params": { "min4xx": 100, "ratio": 0.8, "dayMin4xx": 100 },
      "description": "Client generated predominantly 4xx responses across the corpus or within a single day, consistent with path brute forcing or vulnerability scanning.",
      "falsePositives": "Broken-link crawlers, misconfigured monitoring, uptime checks against a removed path." },
    { "id": "R-SCAN-002", "name": "Sensitive file or backup probing", "category": "Reconnaissance", "severity": "low", "scope": "row", "entity": "row",
      "attack": ["T1595.003"], "enabled": true, "params": { "perIpEscalate": 20 },
      "description": "Request for a well-known sensitive file (.env, wp-config, .git, phpinfo, web.config, debug consoles) or a backup/editor artefact extension that returned 404. Escalates to medium per IP at the threshold.",
      "falsePositives": "Developers fetching their own configuration from internal hosts." },
    { "id": "R-SCAN-003", "name": "Scanner or tooling user agent", "category": "Reconnaissance", "severity": "low", "scope": "row", "entity": "row",
      "attack": ["T1595.002"], "enabled": true, "params": { "excludeInternal": true, "emptyUaFromPublic": true },
      "description": "User agent matches a known scanner, exploitation framework or scripting library, or is empty from a public address.",
      "falsePositives": "Authorized vulnerability scans, health checks, partner integrations using HTTP libraries." },
    { "id": "R-SCAN-004", "name": "Invalid HTTP method or 405/501", "category": "Reconnaissance", "severity": "medium", "scope": "row", "entity": "row",
      "attack": ["T1595.002"], "enabled": true, "params": {},
      "description": "Request used a method outside the valid HTTP/WebDAV set, or the server answered 405/501. Garbage methods are typical of protocol fuzzers and scanners.",
      "falsePositives": "WebDAV clients against sites without WebDAV." },
    { "id": "R-SCAN-005", "name": "IIS request filtering block", "category": "Reconnaissance", "severity": "low", "scope": "row", "entity": "row",
      "attack": ["T1595.003"], "enabled": true, "params": { "substatus": [7, 8, 11, 12, 13, 14, 15, 18, 19], "perIpEscalate": 10 },
      "description": "Request was rejected by IIS request filtering (404.7 extension, 404.8 hidden segment, 404.11 double escape, etc.). Escalates to medium per IP at the threshold.",
      "falsePositives": "Legitimate users with very long query strings (404.15)." },
    { "id": "R-SCAN-006", "name": "Directory listing or handler denial", "category": "Reconnaissance", "severity": "low", "scope": "row", "entity": "row",
      "attack": ["T1595.003"], "enabled": true, "params": { "substatus": [14, 18, 19, 502, 503] },
      "description": "403.14/403.18/403.19/403.502/403.503: attempts to list directories or execute in disallowed pools, or blocked by dynamic IP restriction.",
      "falsePositives": "Users browsing to a folder URL without a default document." },
    { "id": "R-SCAN-007", "name": "Rapid path enumeration", "category": "Reconnaissance", "severity": "medium", "scope": "aggregate", "entity": "ip",
      "attack": ["T1595.003"], "enabled": true, "params": { "distinctStems": 50, "windowMinutes": 5 },
      "description": "Client requested many distinct paths within a short tumbling window.",
      "falsePositives": "Single-page applications loading many resources on first visit (usually internal)." },
    { "id": "R-SCAN-008", "name": "PHP/Xdebug information probe", "category": "Reconnaissance", "severity": "low", "scope": "row", "entity": "row",
      "attack": ["T1592"], "enabled": true, "params": {},
      "description": "Query string requests phpinfo / xdebug information from a public address.",
      "falsePositives": "None expected on a .NET server." },
    { "id": "R-SCAN-009", "name": "Generic mass-scanner profile (PHP probes on .NET server)", "category": "Reconnaissance", "severity": "info", "scope": "aggregate", "entity": "ip",
      "attack": ["T1595.002"], "enabled": true, "params": { "minRows": 20 },
      "description": "Public client requested only PHP/CGI/Perl paths and never a .NET handler, typical of untargeted internet scanning.",
      "falsePositives": "None; informational for noise reduction." },

    { "id": "R-EXP-001", "name": "PHP-CGI argument injection (CVE-2024-4577 / CVE-2012-1823)", "category": "Exploitation", "severity": "high", "scope": "row", "entity": "row",
      "attack": ["T1190"], "enabled": true, "params": { "gradeByStatus": true },
      "description": "Query contains soft-hyphen or dash '-d' PHP ini overrides such as allow_url_include / auto_prepend_file=php://input. Severity follows the response (gradeByStatus): as listed when the server answered 2xx or 5xx, one level lower for 3xx, low for 4xx and other failed requests.",
      "falsePositives": "None realistic." },
    { "id": "R-EXP-002", "name": "Path traversal", "category": "Exploitation", "severity": "high", "scope": "row", "entity": "row",
      "attack": ["T1190", "T1083"], "enabled": true, "params": { "gradeByStatus": true },
      "description": "Dot-dot sequences or their encoded forms in the stem or query. Severity follows the response (gradeByStatus): as listed when the server answered 2xx or 5xx, one level lower for 3xx, low for 4xx and other failed requests.",
      "falsePositives": "Rare: applications passing relative paths in parameters." },
    { "id": "R-EXP-003", "name": "SQL injection tokens", "category": "Exploitation", "severity": "high", "scope": "row", "entity": "row",
      "attack": ["T1190"], "enabled": true, "params": { "gradeByStatus": true, "includeMedium": true },
      "description": "Decoded query contains high-confidence SQL injection tokens (UNION SELECT, WAITFOR DELAY, xp_cmdshell, information_schema) or two or more medium-confidence tokens. Severity follows the response (gradeByStatus): as listed when the server answered 2xx or 5xx, one level lower for 3xx, low for 4xx and other failed requests.",
      "falsePositives": "Search pages where users type SQL-like text; reporting tools passing SQL fragments." },
    { "id": "R-EXP-004", "name": "Command or code injection tokens", "category": "Exploitation", "severity": "high", "scope": "row", "entity": "row",
      "attack": ["T1190", "T1059"], "enabled": true, "params": { "gradeByStatus": true },
      "description": "Stem or decoded query contains shell commands, PowerShell, certutil, JNDI lookups, script tags or command chaining. Severity follows the response (gradeByStatus): as listed when the server answered 2xx or 5xx, one level lower for 3xx, low for 4xx and other failed requests.",
      "falsePositives": "Help-desk or ticketing systems where users paste commands." },
    { "id": "R-EXP-005", "name": ".NET / IIS specific probing", "category": "Exploitation", "severity": "medium", "scope": "row", "entity": "row",
      "attack": ["T1190"], "enabled": true, "params": { "gradeByStatus": true },
      "description": ".NET Remoting endpoints (*.rem, *.soap), Telerik RAU, ELMAH/trace.axd, WebResource/ScriptResource padding-oracle (500 with d=), and ?wsdl/?disco on *.asmx/*.svc returning 500. Severity follows the response (gradeByStatus): as listed when the server answered 2xx or 5xx, one level lower for 3xx, low for 4xx and other failed requests.",
      "falsePositives": "Legitimate SOAP clients fetching WSDL (status 200 is not flagged)." },
    { "id": "R-EXP-006", "name": "Known product exploit path", "category": "Exploitation", "severity": "medium", "scope": "row", "entity": "row",
      "attack": ["T1190"], "enabled": true, "params": { "escalateStatuses": [200, 500] },
      "description": "Request for a path associated with exploitation of a specific product (Exchange, SharePoint, Citrix, Fortinet, Struts, Spring, Confluence, Ivanti, F5...). Escalates to high when any hit returned 200 or 500.",
      "falsePositives": "The product actually runs on this server." },
    { "id": "R-EXP-007", "name": "Server error following exploit attempt", "category": "Exploitation", "severity": "high", "scope": "row", "entity": "row",
      "attack": ["T1190"], "enabled": true, "params": { "windowMinutes": 10 },
      "description": "Status 500 for the same client and path within the window after an exploitation-rule hit from that client.",
      "falsePositives": "Fragile applications that error on any malformed input." },
    { "id": "R-EXP-008", "name": "Oversized or high-entropy request", "category": "Exploitation", "severity": "medium", "scope": "row", "entity": "row",
      "attack": ["T1190"], "enabled": true, "params": { "stemLen": 1024, "queryLen": 2048, "entropy": 5.5, "entropyMinLen": 200 },
      "description": "Very long stem or query, or a long high-entropy query typical of serialized payloads.",
      "falsePositives": "Applications passing encrypted tokens or state in GET parameters." },
    { "id": "R-EXP-009", "name": "Malformed / aborted request from public client", "category": "Exploitation", "severity": "low", "scope": "row", "entity": "row",
      "attack": ["T1190"], "enabled": true, "params": { "statuses": [400, 413, 414, 431], "win32": [1236, 995] },
      "description": "400/413/414/431 from a public client, or an aborted connection on a POST to an executable handler.",
      "falsePositives": "Mobile clients on poor networks." },

    { "id": "R-WS-001", "name": "New executable path reached from the internet", "category": "Persistence", "severity": "critical", "scope": "aggregate", "entity": "stem",
      "attack": ["T1505.003"], "enabled": true, "params": { "baselineDays": 30, "maxDistinctIps": 10 },
      "description": "An executable-extension path first appeared after the baseline period, was requested by a public client and returned 200. Classic indicator of a newly planted web shell. Paths requested by many distinct addresses are treated as application releases and excluded.",
      "falsePositives": "New application pages deployed after the baseline; review first-seen date against change records." },
    { "id": "R-WS-002", "name": "Executable in upload or static directory", "category": "Persistence", "severity": "high", "scope": "aggregate", "entity": "stem",
      "attack": ["T1505.003", "T1105"], "enabled": true, "params": {},
      "description": "An executable-extension path under an upload/attachment/static directory returned 200.",
      "falsePositives": "Applications that legitimately host handlers in such folders (e.g. an UploadAttachment.aspx page)." },
    { "id": "R-WS-003", "name": "Interactive web shell fingerprint", "category": "Persistence", "severity": "critical", "scope": "aggregate", "entity": "stem",
      "attack": ["T1505.003"], "enabled": true, "params": { "maxIps": 2, "minRows": 5, "postRatio": 0.5, "okRatio": 0.8 },
      "description": "Executable path used only by one or two public clients, mostly with POST and mostly 200.",
      "falsePositives": "Single remote user of a niche page; API integrations from a partner." },
    { "id": "R-WS-004", "name": "Web shell names, parameters or client user agents", "category": "Persistence", "severity": "high", "scope": "row", "entity": "row",
      "attack": ["T1505.003"], "enabled": true, "params": { "gradeByStatus": true },
      "description": "Basename matches common web shell names, query contains shell parameters (cmd=, z0=, action=cmd...), or the user agent matches AntSword/Godzilla/Behinder/Weevely. Severity follows the response (gradeByStatus): as listed when the server answered 2xx or 5xx, one level lower for 3xx, low for 4xx and other failed requests.",
      "falsePositives": "Pages named cmd.aspx or test.aspx in legacy applications." },
    { "id": "R-WS-005", "name": "Static extension handled like a script", "category": "Persistence", "severity": "high", "scope": "row", "entity": "row",
      "attack": ["T1505.003"], "enabled": true, "params": {},
      "description": "POST, or GET with a non-versioning query, to an image/text/config extension returned 200 to a public client (handler mapping abuse, polyglot shells).",
      "falsePositives": "Image resizing handlers; analytics beacons on .gif." },
    { "id": "R-WS-006", "name": "Automation profile: only executable handlers, no static assets", "category": "Persistence", "severity": "medium", "scope": "aggregate", "entity": "ip",
      "attack": ["T1505.003", "T1071.001"], "enabled": true, "params": { "minRows": 20, "execRatio": 0.9, "min2xx": 5, "max4xxRatio": 0.5 },
      "description": "Public client whose requests are almost entirely executable handlers with zero static assets, and which mostly succeeds (at least 5 2xx, at most half 4xx): a script or tool driving the application rather than a browser or a 404-heavy scanner.",
      "falsePositives": "Mobile apps and SOAP/API integrations calling .asmx/.ashx endpoints." },
    { "id": "R-WS-007", "name": "Exploit then new executable path from same client", "category": "Persistence", "severity": "critical", "scope": "aggregate", "entity": "stem",
      "attack": ["T1190", "T1505.003"], "enabled": true, "params": {},
      "description": "The first client to request an executable path (with 200) had triggered an exploitation rule before the path first appeared.",
      "falsePositives": "Scanners that later browse normal pages." },

    { "id": "R-AUTH-001", "name": "Login endpoint brute force", "category": "Credential Access", "severity": "medium", "scope": "aggregate", "entity": "ip",
      "attack": ["T1110"], "enabled": true, "params": { "posts": 20, "windowMinutes": 10 },
      "description": "Many POST requests to login endpoints from one client within a tumbling window.",
      "falsePositives": "Shared NAT egress of many users; load tests." },
    { "id": "R-AUTH-002", "name": "Repeated 401 responses", "category": "Credential Access", "severity": "medium", "scope": "aggregate", "entity": "ip",
      "attack": ["T1110"], "enabled": true, "params": { "count": 10, "windowMinutes": 10 },
      "description": "Many 401 responses for one client within a tumbling window; escalated to high when a 200/302 followed within 5 minutes.",
      "falsePositives": "Windows Integrated Authentication negotiation produces 401 pairs; review counts." },
    { "id": "R-AUTH-003", "name": "Authenticated account activity of interest", "category": "Credential Access", "severity": "medium", "scope": "row", "entity": "row",
      "attack": ["T1078"], "enabled": true, "params": { "names": "re:^(?:.*\\\\)?(?:admin|administrator|svc[_\\-]?\\w*|backup|test|sa|root|guest)$" },
      "description": "cs-username populated and either seen for the first time, used from a public address, or a privileged/generic account name.",
      "falsePositives": "Expected service accounts." },
    { "id": "R-AUTH-004", "name": "Internal off-hours use of application handlers", "category": "Lateral Movement", "severity": "low", "scope": "aggregate", "entity": "ip",
      "attack": ["T1078"], "enabled": true, "params": { "rowsPerDay": 50 },
      "description": "Internal client made many executable-handler requests outside configured business hours on a given day (excluding the learned scheduler heartbeat).",
      "falsePositives": "Night shifts, batch jobs, polling dashboards left open." },
    { "id": "R-AUTH-005", "name": "User-agent rotation", "category": "Credential Access", "severity": "low", "scope": "aggregate", "entity": "ip",
      "attack": ["T1110.004"], "enabled": true, "params": { "uasPerDay": 5 },
      "description": "Public client used many distinct user agents within one day, typical of credential-stuffing or scanner tooling.",
      "falsePositives": "Carrier-grade NAT and corporate proxies." },

    { "id": "R-EXF-001", "name": "Archive / database / document downloaded by public client", "category": "Exfiltration", "severity": "medium", "scope": "row", "entity": "row",
      "attack": ["T1005", "T1041"], "enabled": true, "params": {},
      "description": "Public client received 200 for an archive, backup, database, mailbox, office or config file outside public download directories. High for .bak/.mdf/.sql/.config/.pst-class extensions.",
      "falsePositives": "Public document libraries; add them to lists/public-download-directories.txt." },
    { "id": "R-EXF-002", "name": "Large or long-running response to public client", "category": "Exfiltration", "severity": "medium", "scope": "row", "entity": "row",
      "attack": ["T1041"], "enabled": true, "params": { "bytes": 52428800, "takenMs": 60000 },
      "description": "200 response with sc-bytes above the threshold (if logged) or time-taken above the threshold.",
      "falsePositives": "Slow mobile clients; long-polling endpoints." },
    { "id": "R-EXF-003", "name": "Download / attachment / export endpoint use by public client", "category": "Exfiltration", "severity": "low", "scope": "row", "entity": "row",
      "attack": ["T1119", "T1041"], "enabled": true, "params": { "perHourEscalate": 50 },
      "description": "Public client hit a download/attachment/export/report endpoint. Escalates to medium per IP when the hourly rate reaches the threshold.",
      "falsePositives": "Remote staff using the ERP from home." },
    { "id": "R-EXF-004", "name": "Document ID enumeration", "category": "Exfiltration", "severity": "high", "scope": "aggregate", "entity": "ip",
      "attack": ["T1119"], "enabled": true, "params": { "distinctQueries": 200 },
      "description": "Many distinct query strings against a single download/attachment endpoint from one client within an hour.",
      "falsePositives": "Bulk export jobs." },

    { "id": "R-INF-001", "name": "Logging gap", "category": "Defense Evasion", "severity": "high", "scope": "corpus", "entity": "corpus",
      "attack": ["T1070.004", "T1562.002"], "enabled": true, "params": { "gapHours": 4 },
      "description": "Missing daily log files inside the corpus span, or no rows for at least the threshold while surrounding traffic is continuous.",
      "falsePositives": "Server shutdowns, maintenance, sites with no overnight traffic." },
    { "id": "R-INF-002", "name": "Worker process restarts", "category": "Impact", "severity": "low", "scope": "file", "entity": "file",
      "attack": ["T1489"], "enabled": true, "params": { "blocksPerFile": 3, "medianFactor": 3, "errorWindowMinutes": 5 },
      "description": "File contains many more header blocks than is normal for this corpus (each block marks a worker process or logging restart; threshold = max(blocksPerFile, medianFactor x median blocks per file)), or a restart coincides with HTTP 500 errors (escalated to medium).",
      "falsePositives": "Scheduled application pool recycling (every 1740 minutes by default), deployments." },
    { "id": "R-INF-003", "name": "Timestamp anomalies", "category": "Defense Evasion", "severity": "high", "scope": "file", "entity": "file",
      "attack": ["T1070.006"], "enabled": true, "params": { "toleranceHours": 26 },
      "description": "Timestamps go backwards inside a header block, or file content dates disagree with the filename date beyond the rollover tolerance.",
      "falsePositives": "Clock corrections (NTP) produce small backwards steps." },
    { "id": "R-INF-004", "name": "Undersized or truncated log file", "category": "Defense Evasion", "severity": "medium", "scope": "file", "entity": "file",
      "attack": ["T1070.004"], "enabled": true, "params": { "ratio": 0.2, "weeks": 4, "minNeighbours": 4 },
      "description": "File is much smaller than the median of the same weekday in surrounding weeks, or ends without a newline.",
      "falsePositives": "Holidays; the final file of a collection is normally partial." },
    { "id": "R-INF-005", "name": "Logging configuration change", "category": "Defense Evasion", "severity": "info", "scope": "corpus", "entity": "corpus",
      "attack": ["T1562.002"], "enabled": true, "params": {},
      "description": "#Fields schema or #Software version changed mid-corpus.",
      "falsePositives": "IIS upgrades, administrator adding fields." },
    { "id": "R-INF-006", "name": "Heartbeat absent", "category": "Defense Evasion", "severity": "medium", "scope": "corpus", "entity": "corpus",
      "attack": ["T1562.002"], "enabled": true, "params": { "minHours": 2, "minDailyShare": 0.5 },
      "description": "Loopback scheduler traffic normally present every hour stopped for two or more hours on a day where it otherwise ran.",
      "falsePositives": "Application pool stopped for maintenance." },
    { "id": "R-INF-007", "name": "Malformed or undecodable content", "category": "Defense Evasion", "severity": "low", "scope": "file", "entity": "file",
      "attack": ["T1070"], "enabled": true, "params": { "ratio": 0.01 },
      "description": "Malformed rows, non-ASCII bytes or URL decode errors exceed the threshold share of a file.",
      "falsePositives": "Non-UTF-8 logging with localized content." },

    { "id": "C-EXAMPLE-001", "name": "Example custom rule: POST to /webcrm from public client", "category": "Custom", "severity": "info", "scope": "row", "entity": "row",
      "attack": [], "enabled": false,
      "match": { "method": ["POST"], "stem": { "glob": "/webcrm/*" }, "ipClass": ["public"] },
      "description": "Template showing the custom rule format. Enable or copy to create your own.",
      "falsePositives": "" }
  ]
}
</script>
<script type="text/plain" data-res="config/settings.json">{
  "maxRows64": 2000000,
  "maxRows32": 400000,
  "keepRaw64": true,
  "keepRaw32": false,
  "chunkChars": 4194304,
  "chunkChars32": 2097152,
  "streamAboveMB": 32,
  "testNetsPublic": false,
  "checkUpdatesOnStart": false,
  "sliceMs": 25,
  "displayTzId": "UTC",
  "displayTzOffsetMinutes": 0,
  "displayTzLabel": "UTC",
  "businessHours": { "start": "08:00", "end": "19:00", "days": [1, 2, 3, 4, 5] },
  "sessionIdleMinutes": 30,
  "hashOnScan": true,
  "indexCaps": { "ips": 250000, "stems": 500000, "uas": 100000 },
  "ruleHitRetention": 20000,
  "ruleHitRetention32": 10000,
  "internalCidrs": [],
  "allowedIpsFile": "%USERPROFILE%\\.hawk_triage_allowed_ips.txt",
  "iocFile": "%USERPROFILE%\\.hawk_triage_iocs.txt",
  "caseWorkspaceRoot": "%USERPROFILE%\\Documents\\IIS Log Analyzer Cases",
  "examiner": "",
  "recentRoots": [],
  "ruleOverrides": {},
  "geoCsv": ""
}
</script>
<script type="text/plain" data-res="engine/IISScanEngine.cs">// IIS Log Analyzer - fast scan engine (C# 5, compiled at run time by Windows PowerShell 5.1 Add-Type).
//
// Out-of-process equivalent of lib/scan.js S.Scanner: streams every file once and writes the index
// aggregates as ASCII-only JSON. The HTA supplies everything that is data (rules, lists, regex sources,
// field map, constants, time-zone transition table) in a job file, and runs the shared JavaScript
// post-processing (heartbeat, missing files, findings) on the result, so both engines produce the same
// index. Semantics follow JavaScript exactly where it matters: number parsing/printing, Date.UTC,
// string splitting, regex translation (JS -> .NET), null-prototype map behaviour and insertion order.
using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.Text;
using System.Text.RegularExpressions;
using System.Collections.Concurrent;
using System.Threading;

namespace IISLA
{
    // ---------------------------------------------------------------- JSON
    public static class Json
    {
        public static object Parse(string s) { int i = 0; return Val(s, ref i); }
        static void Ws(string s, ref int i) { while (i < s.Length && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r')) i++; }
        static object Val(string s, ref int i)
        {
            Ws(s, ref i);
            char c = s[i];
            if (c == '{')
            {
                i++; var d = new Dictionary<string, object>(); Ws(s, ref i);
                if (s[i] == '}') { i++; return d; }
                while (true)
                {
                    Ws(s, ref i); string k = Str(s, ref i); Ws(s, ref i); i++; // ':'
                    d[k] = Val(s, ref i); Ws(s, ref i);
                    if (s[i] == ',') { i++; continue; }
                    i++; return d;
                }
            }
            if (c == '[')
            {
                i++; var l = new List<object>(); Ws(s, ref i);
                if (s[i] == ']') { i++; return l; }
                while (true)
                {
                    l.Add(Val(s, ref i)); Ws(s, ref i);
                    if (s[i] == ',') { i++; continue; }
                    i++; return l;
                }
            }
            if (c == '"') return Str(s, ref i);
            if (c == 't') { i += 4; return true; }
            if (c == 'f') { i += 5; return false; }
            if (c == 'n') { i += 4; return null; }
            int st = i;
            while (i < s.Length && "+-0123456789.eE".IndexOf(s[i]) >= 0) i++;
            return double.Parse(s.Substring(st, i - st), NumberStyles.Float, CultureInfo.InvariantCulture);
        }
        static string Str(string s, ref int i)
        {
            i++; var sb = new StringBuilder();
            while (true)
            {
                char c = s[i++];
                if (c == '"') break;
                if (c == '\\')
                {
                    char e = s[i++];
                    switch (e)
                    {
                        case 'n': sb.Append('\n'); break;
                        case 'r': sb.Append('\r'); break;
                        case 't': sb.Append('\t'); break;
                        case 'b': sb.Append('\b'); break;
                        case 'f': sb.Append('\f'); break;
                        case 'u': sb.Append((char)Convert.ToInt32(s.Substring(i, 4), 16)); i += 4; break;
                        default: sb.Append(e); break;
                    }
                }
                else sb.Append(c);
            }
            return sb.ToString();
        }
    }

    // Streaming ASCII-only JSON writer (non-ASCII escaped as \uXXXX, like U.asciiJson).
    public sealed class JW
    {
        readonly TextWriter w;
        readonly List<bool> first = new List<bool>();
        public JW(TextWriter w) { this.w = w; }
        void Sep() { if (first.Count > 0) { if (!first[first.Count - 1]) w.Write(','); first[first.Count - 1] = false; } }
        public JW BeginObj() { Sep(); w.Write('{'); first.Add(true); return this; }
        public JW EndObj() { w.Write('}'); first.RemoveAt(first.Count - 1); return this; }
        public JW BeginArr() { Sep(); w.Write('['); first.Add(true); return this; }
        public JW EndArr() { w.Write(']'); first.RemoveAt(first.Count - 1); return this; }
        public JW Key(string k) { Sep(); WriteStr(k); w.Write(':'); first.Add(true); first.RemoveAt(first.Count - 1); suppress = true; return this; }
        bool suppress;
        void SepV() { if (suppress) { suppress = false; return; } Sep(); }
        public JW Str(string s) { SepV(); if (s == null) w.Write("null"); else WriteStr(s); return this; }
        public JW Num(double v) { SepV(); w.Write(Js.JsonNum(v)); return this; }
        public JW Bool(bool b) { SepV(); w.Write(b ? "true" : "false"); return this; }
        public JW Null() { SepV(); w.Write("null"); return this; }
        public JW ObjStart() { SepV(); w.Write('{'); first.Add(true); return this; }
        public JW ArrStart() { SepV(); w.Write('['); first.Add(true); return this; }
        public JW KNum(string k, double v) { return Key(k).Num(v); }
        public JW KStr(string k, string v) { return Key(k).Str(v); }
        public JW KBool(string k, bool v) { return Key(k).Bool(v); }
        public JW Raw(string json) { SepV(); w.Write(json); return this; }
        void WriteStr(string s)
        {
            w.Write('"');
            for (int i = 0; i < s.Length; i++)
            {
                char c = s[i];
                switch (c)
                {
                    case '"': w.Write("\\\""); break;
                    case '\\': w.Write("\\\\"); break;
                    case '\n': w.Write("\\n"); break;
                    case '\r': w.Write("\\r"); break;
                    case '\t': w.Write("\\t"); break;
                    case '\b': w.Write("\\b"); break;
                    case '\f': w.Write("\\f"); break;
                    default:
                        if (c < 0x20 || c >= 0x7f) { w.Write("\\u"); w.Write(((int)c).ToString("x4")); }
                        else w.Write(c);
                        break;
                }
            }
            w.Write('"');
        }
    }

    // ---------------------------------------------------------------- JavaScript semantics
    public static class Js
    {
        public static bool IsWs(char c)
        {
            return c == ' ' || c == '\t' || c == '\n' || c == '\v' || c == '\f' || c == '\r' || c == '\u00a0' || c == '\u1680' || c == '\u180e' ||
                (c >= '\u2000' && c <= '\u200a') || c == '\u2028' || c == '\u2029' || c == '\u202f' || c == '\u205f' || c == '\u3000' || c == '\ufeff';
        }
        public static string Trim(string s)
        {
            int a = 0, b = s.Length;
            while (a < b && IsWs(s[a])) a++;
            while (b > a && IsWs(s[b - 1])) b--;
            return (a == 0 && b == s.Length) ? s : s.Substring(a, b - a);
        }
        // Splits on runs of JS whitespace like s.split(/\s+/) (leading/trailing runs give empty first/last items).
        public static List<string> SplitWs(string s)
        {
            var o = new List<string>(); int i = 0, st = 0;
            while (i <= s.Length)
            {
                if (i == s.Length) { o.Add(s.Substring(st)); break; }
                if (IsWs(s[i])) { o.Add(s.Substring(st, i - st)); while (i < s.Length && IsWs(s[i])) i++; st = i; continue; }
                i++;
            }
            return o;
        }
        static readonly Regex DecLit = new Regex(@"^([0-9]+\.?[0-9]*|\.[0-9]+)([eE][+-]?[0-9]+)?$", RegexOptions.CultureInvariant);
        // ToNumber(string) per ES5 9.3.1
        public static double ToNumber(string s)
        {
            s = Trim(s);
            if (s.Length == 0) return 0;
            if (s.Length > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X'))
            {
                double v = 0;
                for (int i = 2; i < s.Length; i++)
                {
                    int d = HexVal(s[i]); if (d < 0) return double.NaN;
                    v = v * 16 + d;
                }
                return v;
            }
            int p = 0; bool neg = false;
            if (s[0] == '+' || s[0] == '-') { neg = s[0] == '-'; p = 1; }
            string r = s.Substring(p);
            if (r == "Infinity") return neg ? double.NegativeInfinity : double.PositiveInfinity;
            if (!DecLit.IsMatch(r)) return double.NaN;
            double x = double.Parse(r, NumberStyles.AllowDecimalPoint | NumberStyles.AllowExponent, CultureInfo.InvariantCulture);
            return neg ? -x : x;
        }
        public static int HexVal(char c)
        {
            if (c >= '0' && c <= '9') return c - '0';
            if (c >= 'A' && c <= 'F') return c - 'A' + 10;
            if (c >= 'a' && c <= 'f') return c - 'a' + 10;
            return -1;
        }
        // Number.prototype.toString() per ES5 9.8.1 (shortest round-trip digits from "R").
        public static string NumStr(double v)
        {
            if (double.IsNaN(v)) return "NaN";
            if (double.IsPositiveInfinity(v)) return "Infinity";
            if (double.IsNegativeInfinity(v)) return "-Infinity";
            if (v == 0) return "0";
            if (v < 0) return "-" + NumStr(-v);
            if (v == Math.Floor(v) && v < 1e21) return v.ToString("0", CultureInfo.InvariantCulture);
            string r = v.ToString("R", CultureInfo.InvariantCulture);
            // decompose into digits and exponent n (value = 0.digits * 10^n)
            string mant = r, exps = "0";
            int ei = r.IndexOfAny(new char[] { 'E', 'e' });
            if (ei >= 0) { mant = r.Substring(0, ei); exps = r.Substring(ei + 1); }
            int e10 = int.Parse(exps, NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture);
            int dot = mant.IndexOf('.');
            string intPart = dot >= 0 ? mant.Substring(0, dot) : mant, frac = dot >= 0 ? mant.Substring(dot + 1) : "";
            string digits = (intPart + frac).TrimStart('0');
            int lead = (intPart + frac).Length - digits.Length;
            int n = intPart.Length - lead + e10;
            digits = digits.TrimEnd('0'); if (digits.Length == 0) return "0";
            int k = digits.Length;
            if (k <= n && n <= 21) return digits + new string('0', n - k);
            if (0 < n && n <= 21) return digits.Substring(0, n) + "." + digits.Substring(n);
            if (-6 < n && n <= 0) return "0." + new string('0', -n) + digits;
            string es = (n - 1 >= 0 ? "+" : "-") + Math.Abs(n - 1).ToString(CultureInfo.InvariantCulture);
            return k == 1 ? digits + "e" + es : digits.Substring(0, 1) + "." + digits.Substring(1) + "e" + es;
        }
        public static string JsonNum(double v)
        {
            if (double.IsNaN(v) || double.IsInfinity(v)) return "null";
            if (v == Math.Floor(v) && Math.Abs(v) < 9007199254740992.0) return ((long)v).ToString(CultureInfo.InvariantCulture);
            return v.ToString("G17", CultureInfo.InvariantCulture);
        }
        static double ToInteger(double v) { if (double.IsNaN(v)) return 0; if (double.IsInfinity(v)) return v; return v < 0 ? -Math.Floor(-v) : Math.Floor(v); }
        static double DaysFromCivil(double y, double m, double d)
        {
            // proleptic Gregorian, m 1..12
            y -= m <= 2 ? 1 : 0;
            double era = Math.Floor(y / 400);
            double yoe = y - era * 400;
            double doy = Math.Floor((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5) + d - 1;
            double doe = yoe * 365 + Math.Floor(yoe / 4) - Math.Floor(yoe / 100) + doy;
            return era * 146097 + doe - 719468;
        }
        // Date.UTC(year, month, date, hours, minutes, seconds, ms) per ES5 15.9.4.3
        public static double DateUTC(double y, double mo, double d, double h, double mi, double s, double ms)
        {
            if (double.IsNaN(y) || double.IsNaN(mo) || double.IsNaN(d) || double.IsNaN(h) || double.IsNaN(mi) || double.IsNaN(s) || double.IsNaN(ms)) return double.NaN;
            if (double.IsInfinity(y) || double.IsInfinity(mo) || double.IsInfinity(d) || double.IsInfinity(h) || double.IsInfinity(mi) || double.IsInfinity(s) || double.IsInfinity(ms)) return double.NaN;
            double yi = ToInteger(y);
            if (yi >= 0 && yi <= 99) yi += 1900;
            double m = ToInteger(mo), ym = yi + Math.Floor(m / 12), mn = m - Math.Floor(m / 12) * 12;
            double day = DaysFromCivil(ym, mn + 1, 1) + ToInteger(d) - 1;
            double t = day * 86400000.0 + (ToInteger(h) * 3600000.0 + ToInteger(mi) * 60000.0 + ToInteger(s) * 1000.0 + ToInteger(ms));
            if (Math.Abs(t) > 8.64e15) return double.NaN;
            return ToInteger(t);
        }
        public static void CivilFromMs(double t, out long y, out int m, out int d, out int hh)
        {
            double days = Math.Floor(t / 86400000.0);
            double msInDay = t - days * 86400000.0;
            hh = (int)Math.Floor(msInDay / 3600000.0);
            double z = days + 719468, era = Math.Floor(z / 146097), doe = z - era * 146097;
            double yoe = Math.Floor((doe - Math.Floor(doe / 1460) + Math.Floor(doe / 36524) - Math.Floor(doe / 146096)) / 365);
            double yy = yoe + era * 400, doy = doe - (365 * yoe + Math.Floor(yoe / 4) - Math.Floor(yoe / 100));
            double mp = Math.Floor((5 * doy + 2) / 153);
            d = (int)(doy - Math.Floor((153 * mp + 2) / 5) + 1);
            m = (int)(mp < 10 ? mp + 3 : mp - 9);
            y = (long)(yy + (m <= 2 ? 1 : 0));
        }
        public static string P2(long n) { return n < 10 && n >= 0 ? "0" + n : n.ToString(CultureInfo.InvariantCulture); }
        public static string DayKey(double t) { long y; int m, d, h; CivilFromMs(t, out y, out m, out d, out h); return y.ToString(CultureInfo.InvariantCulture) + "-" + P2(m) + "-" + P2(d); }
        public static int UtcHours(double t) { long y; int m, d, h; CivilFromMs(t, out y, out m, out d, out h); return h; }
        // JavaScript String.prototype.toLowerCase / toUpperCase (invariant mapping is equivalent for the
        // characters reachable from cp1252 decoding and percent-decoding of ordinary text).
        public static string Lower(string s) { return s.ToLowerInvariant(); }
        public static string Upper(string s) { return s.ToUpperInvariant(); }
    }

    // Translates a JavaScript regular expression source into an equivalent .NET pattern.
    public static class JsRegex
    {
        const string W = "A-Za-z0-9_";
        const string WB = "(?:(?<=[A-Za-z0-9_])(?![A-Za-z0-9_])|(?<![A-Za-z0-9_])(?=[A-Za-z0-9_]))";
        const string NWB = "(?:(?<=[A-Za-z0-9_])(?=[A-Za-z0-9_])|(?<![A-Za-z0-9_])(?![A-Za-z0-9_]))";
        public static string Translate(string src)
        {
            var sb = new StringBuilder(); bool inClass = false;
            for (int i = 0; i < src.Length; i++)
            {
                char c = src[i];
                if (c == '\\' && i + 1 < src.Length)
                {
                    char n = src[++i];
                    if (inClass)
                    {
                        if (n == 'd') sb.Append("0-9");
                        else if (n == 'w') sb.Append(W);
                        else if (n == 'u' && i + 4 < src.Length) { sb.Append("\\u").Append(src.Substring(i + 1, 4)); i += 4; }
                        else sb.Append('\\').Append(n);
                        continue;
                    }
                    if (n == 'd') sb.Append("[0-9]");
                    else if (n == 'D') sb.Append("[^0-9]");
                    else if (n == 'w') sb.Append("[" + W + "]");
                    else if (n == 'W') sb.Append("[^" + W + "]");
                    else if (n == 'b') sb.Append(WB);
                    else if (n == 'B') sb.Append(NWB);
                    else if (n == 'u' && i + 4 < src.Length) { sb.Append("\\u").Append(src.Substring(i + 1, 4)); i += 4; }
                    else sb.Append('\\').Append(n);
                    continue;
                }
                if (inClass) { if (c == ']') inClass = false; sb.Append(c); continue; }
                if (c == '[')
                {
                    inClass = true; sb.Append(c);
                    if (i + 1 < src.Length && src[i + 1] == '^') { sb.Append('^'); i++; }
                    if (i + 1 < src.Length && src[i + 1] == ']') { sb.Append("\\]"); i++; } // JS [] / [^] edge: treat literally
                    continue;
                }
                if (c == '$') { sb.Append("\\z"); continue; }
                if (c == '.') { sb.Append("[^\\n\\r\\u2028\\u2029]"); continue; }
                sb.Append(c);
            }
            return sb.ToString();
        }
        public static bool HasUpperLiteral(string src)
        {
            for (int i = 0; i < src.Length; i++)
            {
                char c = src[i];
                if (c == '\\') { if (i + 1 < src.Length && src[i + 1] == 'u') i += 5; else i++; continue; }
                if (c >= 'A' && c <= 'Z') return true;
            }
            return false;
        }
        public static Regex Make(string src, bool ignoreCase)
        {
            var o = RegexOptions.CultureInvariant | RegexOptions.Compiled;
            if (ignoreCase) o |= RegexOptions.IgnoreCase;
            return new Regex(Translate(src), o);
        }
    }

    // Insertion-ordered string map with JS-like delete/re-add semantics (deleted keys re-added go last).
    public sealed class OMap<V>
    {
        readonly Dictionary<string, int> ix = new Dictionary<string, int>(StringComparer.Ordinal);
        readonly List<string> keys = new List<string>();
        readonly List<V> vals = new List<V>();
        readonly List<bool> alive = new List<bool>();
        int dead;
        public int Count { get { return ix.Count; } }
        public bool TryGet(string k, out V v) { int i; if (ix.TryGetValue(k, out i)) { v = vals[i]; return true; } v = default(V); return false; }
        public bool Has(string k) { return ix.ContainsKey(k); }
        public V this[string k]
        {
            get { return vals[ix[k]]; }
            set { int i; if (ix.TryGetValue(k, out i)) vals[i] = value; else { ix[k] = keys.Count; keys.Add(k); vals.Add(value); alive.Add(true); } }
        }
        public void Remove(string k)
        {
            int i; if (!ix.TryGetValue(k, out i)) return;
            ix.Remove(k); alive[i] = false; vals[i] = default(V); dead++;
            if (dead > 4096 && dead > keys.Count / 2) Compact();
        }
        void Compact()
        {
            var nk = new List<string>(); var nv = new List<V>(); var na = new List<bool>();
            for (int i = 0; i < keys.Count; i++) if (alive[i]) { ix[keys[i]] = nk.Count; nk.Add(keys[i]); nv.Add(vals[i]); na.Add(true); }
            keys.Clear(); keys.AddRange(nk); vals.Clear(); vals.AddRange(nv); alive.Clear(); alive.AddRange(na); dead = 0;
        }
        public List<string> Keys() { var o = new List<string>(ix.Count); for (int i = 0; i < keys.Count; i++) if (alive[i]) o.Add(keys[i]); return o; }
        public void Inc(string k) { int i; if (ix.TryGetValue(k, out i)) vals[i] = (V)(object)(Convert.ToDouble(vals[i]) + 1.0); else this[k] = (V)(object)1.0; }
    }

    // ---------------------------------------------------------------- utilities ported from util.js
    public sealed class Cidr { public int V; public double Base, Size; public string Hex; public double Bits; }
    public static class IpUtil
    {
        static readonly Regex V4 = new Regex(@"^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$", RegexOptions.CultureInvariant);
        static readonly Regex V6chars = new Regex("^[0-9a-f:.]+$", RegexOptions.CultureInvariant);
        static readonly Regex V4tail = new Regex(@"([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)$", RegexOptions.CultureInvariant);
        static readonly Regex Hex4 = new Regex("^[0-9a-f]{1,4}$", RegexOptions.CultureInvariant);
        public static List<Cidr> ExtraInternal = new List<Cidr>();
        public static HashSet<string> Allow = new HashSet<string>(StringComparer.Ordinal);
        public static double ParseV4(string s)
        {
            var m = V4.Match(s); if (!m.Success) return -1;
            double a = Js.ToNumber(m.Groups[1].Value), b = Js.ToNumber(m.Groups[2].Value), c = Js.ToNumber(m.Groups[3].Value), d = Js.ToNumber(m.Groups[4].Value);
            if (a > 255 || b > 255 || c > 255 || d > 255) return -1;
            return ((a * 256 + b) * 256 + c) * 256 + d;
        }
        public static string ExpandV6(string s)
        {
            s = Js.Lower(s);
            int pct = s.IndexOf('%'); if (pct >= 0) s = s.Substring(0, pct);
            if (s.Length > 0 && s[0] == '[') s = Regex.Replace(s, @"^\[|\]\z", "");
            if (!V6chars.IsMatch(s) || s.IndexOf(':') < 0) return null;
            var v4 = V4tail.Match(s);
            if (v4.Success)
            {
                double n = ParseV4(v4.Groups[1].Value); if (n < 0) return null;
                long hi = (long)Math.Floor(n / 65536), lo = (long)(n % 65536);
                s = s.Substring(0, s.Length - v4.Groups[1].Value.Length) + ("0000" + hi.ToString("x")).Substring(("0000" + hi.ToString("x")).Length - 4) + ":" + ("0000" + lo.ToString("x")).Substring(("0000" + lo.ToString("x")).Length - 4);
            }
            string[] parts = s.Split(new string[] { "::" }, StringSplitOptions.None);
            if (parts.Length > 2) return null;
            var head = parts[0].Length > 0 ? new List<string>(parts[0].Split(':')) : new List<string>();
            var tail = parts.Length == 2 && parts[1].Length > 0 ? new List<string>(parts[1].Split(':')) : new List<string>();
            int fill = 8 - head.Count - tail.Count;
            if (parts.Length == 1 && fill != 0) return null;
            if (fill < 0) return null;
            var all = new List<string>(head); for (int i = 0; i < fill; i++) all.Add("0"); all.AddRange(tail);
            var sb = new StringBuilder();
            for (int i = 0; i < 8; i++)
            {
                if (i >= all.Count || !Hex4.IsMatch(all[i])) return null;
                string p = "0000" + all[i]; sb.Append(p.Substring(p.Length - 4));
            }
            return sb.ToString();
        }
        public static bool IsValid(string s) { return ParseV4(s) >= 0 || ExpandV6(s) != null; }
        public static Cidr ParseCidr(string s)
        {
            s = Js.Trim(s);
            int slash = s.IndexOf('/');
            string ip = slash >= 0 ? s.Substring(0, slash) : s;
            double bits = slash >= 0 ? Js.ToNumber(s.Substring(slash + 1)) : -1;
            double n4 = ParseV4(ip);
            if (n4 >= 0)
            {
                if (bits < 0) bits = 32;
                if (!(bits >= 0 && bits <= 32)) return null;
                double size = Math.Pow(2, 32 - bits);
                return new Cidr { V = 4, Base = Math.Floor(n4 / size) * size, Size = size };
            }
            string h = ExpandV6(ip);
            if (h != null)
            {
                if (bits < 0) bits = 128;
                if (!(bits >= 0 && bits <= 128)) return null;
                return new Cidr { V = 6, Hex = h, Bits = bits };
            }
            return null;
        }
        static bool HexPrefix(string a, string b, double bitsD)
        {
            int bits = (int)bitsD, full = bits / 4, rem = bits % 4;
            if (string.CompareOrdinal(a, 0, b, 0, full) != 0) return false;
            if (rem == 0) return true;
            int m = (0xF << (4 - rem)) & 0xF;
            return (Js.HexVal(a[full]) & m) == (Js.HexVal(b[full]) & m);
        }
        public static bool CidrMatch(Cidr c, string ip)
        {
            if (c == null) return false;
            if (c.V == 4)
            {
                double n = ParseV4(ip);
                if (n < 0)
                {
                    string h = ExpandV6(ip);
                    if (h != null && h.Substring(0, 24) == "00000000000000000000ffff") n = Convert.ToInt64(h.Substring(24), 16); else return false;
                }
                return n >= c.Base && n < c.Base + c.Size;
            }
            string hx = ExpandV6(ip);
            return hx != null && HexPrefix(hx, c.Hex, c.Bits);
        }
        public static string Classify(string s)
        {
            if (string.IsNullOrEmpty(s) || s == "-") return "none";
            if (Allow.Count > 0 && Allow.Contains(Js.Lower(s))) return "allowlisted";
            double n = ParseV4(s);
            if (n < 0)
            {
                string h = ExpandV6(s);
                if (h == null) return "invalid";
                if (h.Substring(0, 24) == "00000000000000000000ffff")
                {
                    long v = Convert.ToInt64(h.Substring(24), 16);
                    return Classify((v / 16777216) + "." + ((v / 65536) % 256) + "." + ((v / 256) % 256) + "." + (v % 256));
                }
                if (h == "00000000000000000000000000000001") return "loopback";
                foreach (var c in ExtraInternal) if (CidrMatch(c, s)) return "internal";
                if (h.StartsWith("fe8", StringComparison.Ordinal) || h.StartsWith("fe9", StringComparison.Ordinal) || h.StartsWith("fea", StringComparison.Ordinal) || h.StartsWith("feb", StringComparison.Ordinal)) return "linklocal";
                if (h.StartsWith("fc", StringComparison.Ordinal) || h.StartsWith("fd", StringComparison.Ordinal)) return "rfc1918";
                if (h == "00000000000000000000000000000000" || h.StartsWith("ff", StringComparison.Ordinal) || (!TestNetsPublic && h.StartsWith("20010db8", StringComparison.Ordinal))) return "bogon";
                return "public";
            }
            double a = Math.Floor(n / 16777216), b = Math.Floor(n / 65536) % 256;
            if (a == 127) return "loopback";
            foreach (var c in ExtraInternal) if (CidrMatch(c, s)) return "internal";
            if (a == 10 || (a == 172 && b >= 16 && b <= 31) || (a == 192 && b == 168)) return "rfc1918";
            if (a == 169 && b == 254) return "linklocal";
            if (a == 100 && b >= 64 && b <= 127) return "cgnat";
            double c3 = Math.Floor(n / 256) % 256;
            bool testNet = (a == 192 && b == 0 && c3 == 2) || (a == 198 && b == 51 && c3 == 100) || (a == 203 && b == 0 && c3 == 113);
            if (a == 0 || a >= 224 || (testNet && !TestNetsPublic) || (a == 198 && (b == 18 || b == 19))) return "bogon";
            return "public";
        }
        public static bool IsInternalClass(string c) { return c == "rfc1918" || c == "internal" || c == "loopback" || c == "linklocal"; }
        // Training and demo data only (mirrors util.js setTestNetsPublic): documentation ranges classify as public.
        public static bool TestNetsPublic;
    }

    public static class TextUtil
    {
        public static string ReEscape(string s) { return Regex.Replace(s, @"[.*+?^${}()|[\]\\/]", "\\$0"); }
        public static string GlobToRegexSrc(string g)
        {
            var sb = new StringBuilder();
            foreach (char c in g) { if (c == '*') sb.Append(".*"); else if (c == '?') sb.Append('.'); else sb.Append(ReEscape(c.ToString())); }
            return "^" + sb + "$";
        }
        public static string ExtOf(string stemLower)
        {
            int slash = stemLower.LastIndexOf('/');
            string b = stemLower.Substring(slash + 1);
            int dot = b.LastIndexOf('.');
            return dot > 0 || (dot == 0 && b.Length > 1) ? b.Substring(dot) : "";
        }
        public static string DirOf(string stemLower) { int slash = stemLower.LastIndexOf('/'); return slash > 0 ? stemLower.Substring(0, slash + 1) : "/"; }
        // U.pctDecode
        public static string PctDecode(string s, bool plus, out bool err)
        {
            err = false;
            if (s == null || s == "-") return "";
            if (s.IndexOf('%') < 0) return plus ? s.Replace('+', ' ') : s;
            var bytes = new List<int>(); var outb = new StringBuilder(); int n = s.Length;
            bool e = false;
            Action flush = () =>
            {
                if (bytes.Count == 0) return;
                string r = Utf8(bytes); if (r == null) { e = true; r = Latin(bytes); }
                outb.Append(r); bytes.Clear();
            };
            for (int i = 0; i < n; i++)
            {
                int c = s[i];
                if (c == 37 && i + 2 < n)
                {
                    int h1 = Js.HexVal(s[i + 1]), h2 = Js.HexVal(s[i + 2]);
                    if (h1 >= 0 && h2 >= 0) { bytes.Add(h1 * 16 + h2); i += 2; continue; }
                    if (s[i + 1] == 'u' || s[i + 1] == 'U') e = true;
                }
                else if (c == 37) e = true;
                flush();
                outb.Append(plus && c == 43 ? ' ' : s[i]);
            }
            flush();
            err = e;
            return outb.ToString();
        }
        static string Latin(List<int> b) { var sb = new StringBuilder(); foreach (int x in b) sb.Append((char)x); return sb.ToString(); }
        public static string Utf8(List<int> b)
        {
            var s = new StringBuilder(); int i = 0;
            while (i < b.Count)
            {
                int c = b[i];
                if (c < 0x80) { s.Append((char)c); i++; continue; }
                if (c >= 0xC2 && c < 0xE0)
                {
                    if (i + 1 >= b.Count || (b[i + 1] & 0xC0) != 0x80) return null;
                    s.Append((char)(((c & 0x1F) << 6) | (b[i + 1] & 0x3F))); i += 2; continue;
                }
                if (c >= 0xE0 && c < 0xF0)
                {
                    if (i + 2 >= b.Count || (b[i + 1] & 0xC0) != 0x80 || (b[i + 2] & 0xC0) != 0x80) return null;
                    int cp = ((c & 0x0F) << 12) | ((b[i + 1] & 0x3F) << 6) | (b[i + 2] & 0x3F);
                    if (cp < 0x800) return null;
                    s.Append((char)cp); i += 3; continue;
                }
                if (c >= 0xF0 && c < 0xF5)
                {
                    if (i + 3 >= b.Count || (b[i + 1] & 0xC0) != 0x80 || (b[i + 2] & 0xC0) != 0x80 || (b[i + 3] & 0xC0) != 0x80) return null;
                    int cp = ((c & 0x07) << 18) | ((b[i + 1] & 0x3F) << 12) | ((b[i + 2] & 0x3F) << 6) | (b[i + 3] & 0x3F);
                    if (cp < 0x10000 || cp > 0x10FFFF) return null;
                    cp -= 0x10000;
                    s.Append((char)(0xD800 + (cp >> 10))).Append((char)(0xDC00 + (cp & 0x3FF))); i += 4; continue;
                }
                return null;
            }
            return s.ToString();
        }
        // U.entropy: integer-like keys ('0'..'9') are summed first in ascending order, then other characters
        // in first-seen order, matching JavaScript object key enumeration.
        public static double Entropy(string s)
        {
            if (string.IsNullOrEmpty(s)) return 0;
            var counts = new Dictionary<char, int>(); var order = new List<char>();
            foreach (char c in s) { int v; if (counts.TryGetValue(c, out v)) counts[c] = v + 1; else { counts[c] = 1; order.Add(c); } }
            double h = 0, n = s.Length;
            for (char d = '0'; d <= '9'; d++) { int v; if (counts.TryGetValue(d, out v)) { double p = v / n; h -= p * Math.Log(p) / Math.Log(2); } }
            foreach (char c in order) { if (c >= '0' && c <= '9') continue; double p = counts[c] / n; h -= p * Math.Log(p) / Math.Log(2); }
            return h;
        }
    }

    // Windows-1252 <-> bytes and UTF-8 re-decoding of a line (U.fixUtf8).
    public static class Cp1252
    {
        static readonly int[] High = { 0x20AC, 0x81, 0x201A, 0x192, 0x201E, 0x2026, 0x2020, 0x2021, 0x2C6, 0x2030, 0x160, 0x2039, 0x152, 0x8D, 0x17D, 0x8F,
            0x90, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014, 0x2DC, 0x2122, 0x161, 0x203A, 0x153, 0x9D, 0x17E, 0x178 };
        static readonly Dictionary<int, int> Rev = new Dictionary<int, int>();
        static Cp1252() { for (int i = 0; i < 32; i++) Rev[High[i]] = 0x80 + i; }
        public static string FixUtf8(string line)
        {
