  UI.confirm = function (title, msg, onYes, yesLabel) {
    UI.dialog({ title: title, body: UI.h('div', { className: 'pre-wrap' }, msg), buttons: [{ label: yesLabel || 'OK', primary: true, onClick: function () { onYes(); } }, { label: 'Cancel' }] });
  };
