      UI.toast('Loaded ' + U.fmtNum(store.n) + ' rows (scanned ' + U.fmtNum(store.scanned) + ') in ' + U.fmtDuration(store.loadMs) + (store.cancelled ? ' - CANCELLED, partial' : ''));
